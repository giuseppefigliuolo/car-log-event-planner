---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/sections/Marquee.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import About from '../components/sections/About.astro';
import Stories from '../components/sections/Stories.astro';
import Instagram from '../components/sections/Instagram.astro';
import Contact from '../components/sections/Contact.astro';
import { getHome, getSettings } from '../lib/content';

const home = await getHome();
const settings = await getSettings();
---

<Base home={home} settings={settings}>
  <Intro home={home} settings={settings} />
  <Header settings={settings} kicker={home.hero.kicker} />
  <main id="main">
    <Hero home={home} settings={settings} />
    <Marquee home={home} />
    <Manifesto home={home} />
    <About home={home} settings={settings} />
    <Stories home={home} />
    <Instagram home={home} settings={settings} />
    <Contact home={home} settings={settings} />
  </main>
  <Footer settings={settings} />
  <Fab settings={settings} />
</Base>
