---
/**
 * Hero: one <section>, one h1, rearranged by CSS at the 900px breakpoint.
 * <900px "Mazzo": the name fitted to a centred block (JS, [data-fit="m"]), below it a pile of Polaroids of
 *   what Carmen organises — tap, swipe or "Sfoglia" to flip, autoplay (features/deck.ts) — and WhatsApp.
 * ≥900px "Split": text column left, the vertical photo right, full height.
 * Entrance: [data-hl] titles, [data-hf] texts, [data-hi] photo wipe (global.css), cards fly in (deck.ts).
 * Each layout's photos are downloaded only where that layout shows (Img `skip`); the cards behind the first two
 * wait for the page to be idle (Img `defer`).
 */
import type { Home, Settings } from '../../lib/content';
import { areaLabel, whatsappHref } from '../../lib/contact';
import { pileStyle } from '../../lib/deck';
import Img from '../ui/Img.astro';
import Brand from '../ui/Brand.astro';

interface Props { home: Home; settings: Settings }
const { home, settings: s } = Astro.props;
const h = home.hero;
const n = h.deck.length;
const canFlip = h.deck.some((c) => c.back);
const pad = (x: number) => String(x).padStart(2, '0');
// Keep in sync with the CSS below and isWide() (900px).
const NARROW = '(max-width: 899.98px)';
const WIDE = '(min-width: 900px)';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <span class="tag" data-hf>{h.kicker} · {s.area.region}</span>
  <div class="media hero-media" data-hi data-cursor="Guarda">
    <Img
      src={h.image.src} alt={h.image.alt} priority class="cover" skip={NARROW}
      sizes="(min-width: 900px) 44vw, 100vw" widths={[480, 768, 1051]}
      data-px="-0.18" data-ps="1.14" data-px-wide="-0.12" data-ps-wide="1.12"
    />
  </div>
  <div class="body">
    <div class="meta kicker" data-hf><span>{h.kicker}</span><span>{h.meta}</span></div>
    <div class="name">
      <h1 id="hero-title" class="title display" data-fit="m">
        <Brand name={s.brand} />
        <span class="sr-only"> — {s.tagline} in {areaLabel(s)}</span>
      </h1>
      <p class="phrase" data-hf style="--i:1">{h.leadMobile}</p>
    </div>
    <div class="foot">
      <p data-hf style="--i:1">{h.lead} {h.leadDesktop}</p>
      <span class="scroll kicker" data-hf style="--i:2" aria-hidden="true">{h.scroll} <span class="tick"></span></span>
    </div>
  </div>
  <div class="deck" data-deck>
    {h.deck.map((c, i) => {
      const p = pileStyle(i, i, n);
      return (
        <div class="card" data-card style={`z-index:${p.zIndex};opacity:${p.opacity};transform:${p.transform}`}>
          <div class="flip" data-flip="0">
            <figure class="face front" data-face="front">
              <div class="media photo">
                <Img src={c.image.src} alt={c.image.alt} class="cover" sizes="min(300px, 66vw)" widths={[320, 480, 640, 900]} ratio={4 / 5} priority={i < 2} defer={i >= 2} skip={WIDE} />
              </div>
              <figcaption>{c.title}</figcaption>
            </figure>
            {c.back && (
              <div class="face back" data-face="back" aria-hidden="true">
                <div class="row">
                  <span class="mono num">{pad(i + 1)} · {c.title}</span>
                  <span class="mono-gram" aria-hidden="true">CL</span>
                </div>
                <p class="note">{c.back}</p>
                <span class="sign">— {s.founder}</span>
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>
  <div class="ctrl" data-deck-ctrl data-hf style="--i:2">
    <span class="count" data-deck-count aria-live="polite">01 / {pad(n)}</span>
    <span class="acts">
      {canFlip && <button class="act" type="button" data-deck-flip aria-label="Gira la foto">Gira <span aria-hidden="true">↻</span></button>}
      <button class="act" type="button" data-deck-next aria-label="Sfoglia: foto successiva">Sfoglia <span aria-hidden="true">→</span></button>
    </span>
  </div>
  <a class="btn cta" data-hf style="--i:3" href={whatsappHref(s)} target="_blank" rel="noopener">
    {h.cta} <span aria-hidden="true">↗</span>
  </a>
</section>

<style>
  /* ---------- <900px: Mazzo ---------- */
  .hero {
    position: relative; height: 100svh; min-height: 600px; overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
    padding: 76px clamp(16px, 3vw, 40px) max(22px, env(safe-area-inset-bottom));
  }
  .hero-media, .meta, .foot { display: none; }
  .hero-media :global(img) { object-position: 50% 30%; }
  .body { display: contents; }

  /* Level with the header's Menu button; stands in for the logo, hidden over this hero (chrome.ts). */
  .tag {
    position: absolute; left: var(--gutter); top: 31px;
    font-size: 10px; line-height: 1; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--muted); white-space: nowrap;
  }

  .name {
    width: min(78%, 360px); flex: none;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .title {
    display: flex; gap: 0.2em; width: max-content; white-space: nowrap;
    /* Close to the fitted size before JS measures (block width / line width at 1em). */
    font-size: calc(min((100vw - 2 * clamp(16px, 3vw, 40px)) * 0.78, 360px) * 0.193);
    line-height: 0.9;
  }
  .phrase { max-width: 250px; font-size: 14px; line-height: 1.5; color: var(--fg-2); text-align: center; text-wrap: balance; }
  /* Short phones: the deck keeps the room. */
  @media (max-height: 720px) { .phrase { display: none; } }

  .deck {
    position: relative; flex: 1 1 auto; min-height: 0; width: 100%;
    margin-top: clamp(8px, 2svh, 18px);
    container-type: size;
    touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
    cursor: grab;
  }
  .card {
    /* deck.ts sets the same size in px; this is the first paint (and the layout without JS). */
    --cw: max(150px, min(74cqw, 300px, (100cqh - 85.5px) / 1.25));
    position: absolute; width: var(--cw);
    left: calc((100cqw - var(--cw)) / 2);
    top: max(0px, (100cqh - 1.25 * var(--cw) - 73.5px) / 2);
    perspective: 1100px;
    will-change: transform;
    transition: transform 0.8s var(--ease), opacity 0.5s ease;
  }
  /* Below the screen until the entrance flies them in (deck.ts animates translate/rotate, the pile uses transform). */
  :global(.m) .hero:not(:global(.is-in)) .card { translate: 0 115vh; }
  /* Turns on tap / "Gira" (deck.ts sets data-flip="1"). The front gives the box its height. */
  .flip {
    position: relative;
    transform-style: preserve-3d; -webkit-transform-style: preserve-3d;
    transition: transform 0.8s var(--ease);
  }
  .flip[data-flip="1"] { transform: rotateY(180deg); }
  .face {
    margin: 0;
    background: #fffdf9;
    box-shadow: 0 1px 2px rgba(42, 34, 33, 0.08), 0 24px 50px -14px rgba(42, 34, 33, 0.3);
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
  }
  .front { padding: 9px 9px 0; }
  .back {
    position: absolute; inset: 0; transform: rotateY(180deg);
    background: #fbf7f1;
    display: flex; flex-direction: column; justify-content: space-between; gap: 14px;
    padding: 22px 20px 18px;
  }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .num { font-size: 10px; letter-spacing: 0.06em; color: var(--muted); }
  .mono-gram {
    flex: none; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(164, 94, 104, 0.5); border-radius: 50%;
    font: italic 400 11px/1 var(--display); color: var(--accent);
  }
  .note { font: 400 clamp(21px, 6vw, 25px) / 1.22 var(--hand); color: var(--fg); text-wrap: balance; }
  .sign { align-self: flex-end; font: 400 23px/1 var(--hand); color: var(--accent); }
  .photo { aspect-ratio: 4 / 5; }
  .photo :global(img) { pointer-events: none; }
  figcaption {
    padding: 12px 4px 14px; text-align: center;
    font: italic 400 19px/1.1 var(--display); letter-spacing: -0.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .ctrl {
    width: min(74%, 300px); flex: none; margin-top: 4px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .count { font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; color: var(--muted); }
  .acts { display: flex; align-items: center; gap: 18px; }
  .act {
    height: 40px; padding: 0; background: none; border: 0; cursor: pointer;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .cta { margin-top: 10px; padding: 15px 26px; }

  @media (max-width: 899.98px) {
    .title { letter-spacing: -0.035em; }
    .title :global(.mask) { margin: 0; padding: 0.04em 0 0.14em; }
    .title :global(.mask:nth-child(2)) { padding: 0.04em 0.1em 0.14em 0; }
  }

  /* ---------- ≥900px: Split ---------- */
  @media (min-width: 900px) {
    .hero { flex-direction: row; align-items: stretch; min-height: 660px; padding: 0; }
    .tag, .phrase, .deck, .ctrl, .cta { display: none; }
    .hero-media { display: block; position: relative; order: 2; flex: 0 0 44%; }
    .body {
      position: relative; min-width: 0; flex: 1 1 56%;
      display: flex; flex-direction: column; justify-content: space-between; gap: 32px;
      padding: 130px clamp(28px, 3.4vw, 56px) clamp(28px, 3vw, 48px);
    }
    .name { display: contents; }
    .meta { display: flex; justify-content: space-between; gap: 16px; }
    .title { display: block; width: auto; white-space: normal; font-size: min(12.6vw, 26vh); }
    .title :global(.mask:nth-child(2)) { padding-left: 1.1em; }
    .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
    .foot p { max-width: 380px; font-size: 17px; line-height: 1.6; color: var(--fg-2); text-wrap: pretty; }
    .scroll { display: flex; align-items: center; gap: 10px; flex: none; }
    .tick { display: block; width: 1px; height: 28px; background: var(--fg); }
  }
</style>
