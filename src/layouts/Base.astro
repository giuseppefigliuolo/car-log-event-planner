---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import type { Home, Settings } from '../lib/content';
import { basePath } from '../lib/url';

interface Props {
  home: Home;
  settings: Settings;
  /** Title/description of an inner page (the home's own when omitted). */
  page?: { title: string; description: string };
  /** The first-visit intro belongs to the home only. */
  intro?: boolean;
}

const { home, settings, page, intro: withIntro = true } = Astro.props;
// Collaudo / preview builds stay out of search engines until INDEXABLE=true.
const indexable = process.env.INDEXABLE === 'true';
const intro = withIntro && settings.intro.enabled;
---

<!doctype html>
<html lang="it" data-intro={intro ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f4ef" />
    <meta name="format-detection" content="telephone=no" />
    <!-- Decides motion + intro before first paint: no flash, no layout shift. -->
    {/* Intro: first visit only. `cl-intro-seen` is written when the intro ENDS (features/intro.ts), so closing
         the tab halfway means seeing it again. Seen / reduced motion → data-intro="skip" (the overlay stays hidden);
         storage blocked → treated as a first visit. In dev, ?introreset=1 forgets the visit. */}
    <script is:inline define:vars={{ dev: import.meta.env.DEV }}>
      (function () {
        var d = document.documentElement;
        try {
          if (dev && /[?&]introreset=1(&|$)/.test(location.search)) localStorage.removeItem('cl-intro-seen');
        } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { d.dataset.intro = 'skip'; return; }
        d.classList.add('m');
        if (d.dataset.intro !== '1') return;
        var seen = false;
        try { seen = localStorage.getItem('cl-intro-seen') === '1'; } catch (e) {}
        if (seen) { d.dataset.intro = 'skip'; return; }
        d.classList.add('intro');
        // Failsafe if the script never loads: release the page.
        setTimeout(function () { d.classList.remove('intro'); }, 7000);
      })();
    </script>
    <Font cssVariable="--font-display" preload={[{ weight: 400, style: 'normal' }, { weight: 400, style: 'italic' }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-hand" />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${basePath}sitemap-index.xml`} />
    <Seo home={home} settings={settings} indexable={indexable} page={page} />
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
